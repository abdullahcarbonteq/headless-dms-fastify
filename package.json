{
  "name": "headless-dms-fastify",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch -r dotenv/config -r tsconfig-paths/register src/infrastructure/cli/index.ts dev",
    "dev:nr": "tsx watch -r newrelic -r dotenv/config -r tsconfig-paths/register src/infrastructure/cli/index.ts dev",
    "build": "tsc",
    "start": "node dist/infrastructure/cli/index.js start",
    "typecheck": "tsc --noEmit",
    "cli": "tsx -r newrelic -r dotenv/config -r tsconfig-paths/register src/infrastructure/cli/index.ts",
    "cli:dev": "tsx -r newrelic -r dotenv/config -r tsconfig-paths/register src/infrastructure/cli/index.ts dev",
    "cli:start": "tsx -r newrelic -r dotenv/config -r tsconfig-paths/register src/infrastructure/cli/index.ts start",
    "cli:health": "tsx -r newrelic -r dotenv/config -r tsconfig-paths/register src/infrastructure/cli/index.ts health",
    "cli:config": "tsx -r newrelic -r dotenv/config -r tsconfig-paths/register src/infrastructure/cli/index.ts config",
    "test": "mocha",
    "test:watch": "mocha --watch",
    "test:coverage": "mocha --reporter=spec --reporter=html",
    "test:unit": "mocha tests/**/*.test.ts",
    "test:domain": "mocha tests/domain/**/*.test.ts",
    "test:application": "mocha tests/application/**/*.test.ts",
    "test:infrastructure": "mocha tests/infrastructure/**/*.test.ts",
    "test:presentation": "mocha tests/presentation/**/*.test.ts",
    "test:integration": "mocha tests/integration/**/*.spec.ts",
    "test:e2e": "mocha tests/e2e/**/*.spec.ts",
    "test:example": "mocha tests/example-value-object.spec.ts",
    "seed": "tsx -r newrelic -r dotenv/config -r tsconfig-paths/register src/infrastructure/cli/index.ts seed",
    "seed:reset": "tsx -r newrelic -r dotenv/config -r tsconfig-paths/register src/infrastructure/cli/index.ts seed --reset"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdullahcarbonteq/headless-dms-fastify.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/abdullahcarbonteq/headless-dms-fastify/issues"
  },
  "homepage": "https://github.com/abdullahcarbonteq/headless-dms-fastify#readme",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "@azure/storage-blob": "^12.24.0",
    "@carbonteq/fp": "^0.8.2",
    "@carbonteq/hexapp": "^0.20.1",
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@google-cloud/storage": "^7.13.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "commander": "^14.0.0",
    "dotenv": "^17.2.0",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.3",
    "fastify": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "newrelic": "^11.23.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "tsconfig-paths": "^4.2.0",
    "tsyringe": "^4.10.0",
    "uuid": "^11.1.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.15.4",
    "@types/sinon": "^17.0.4",
    "@types/uuid": "^10.0.0",
    "chai": "^5.2.1",
    "mocha": "^11.7.1",
    "sinon": "^21.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
