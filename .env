#postgres://dmsuser-fastify:ilovefastify@localhost:5432/fastifydbv2
JWT_SECRET=supersecret
UPLOAD_ALLOWED_MIME_TYPES=image/png,image/jpeg,application/pdf,text/plain
NEW_RELIC_LICENSE_KEY=9497de2c3af1e23b7d7ccf85d5fe6ee3FFFFNRAL

# ==========================
# S3 / MinIO
# ==========================
# Required
S3_BUCKET=my-bucket
AWS_REGION=us-east-1
# Optional (useful for MinIO/localstack)
S3_PREFIX=uploads/
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_TIMEOUT_MS=30000

# ==========================
# Google Cloud Storage (GCS)
# ==========================
# Required
GCS_BUCKET=my-gcs-bucket
# Optional
GCS_PREFIX=uploads/
# Path to service account JSON (if not using ADC/metadata server)
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Emulator/local dev options (if using an emulator)
STORAGE_EMULATOR_HOST=http://localhost:4443

# ==========================
# Azure Blob Storage
# ==========================
# Required
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=REDACTED;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
AZURE_CONTAINER=my-container
# Optional
AZURE_PREFIX=uploads/